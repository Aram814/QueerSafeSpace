# Copy to web/.env.local and fill in. .env.local is gitignored.
# Both values are safe to ship in a browser bundle; row-level security is what
# protects the data. Never put the service_role key or the Supabase Management
# API token in here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional. Where the "Support QueerSafeSpace" donate button goes (a Ko-fi or Stripe link).
# Leave empty to hide the donation page and menu item.
VITE_DONATE_URL=
VITE_DONATE_PROVIDER=
